<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>vm2.Glob.Api.FakeFileSystem.Tests</RootNamespace>

        <!-- MTP v2: Extend base exclusions to also exclude Glob.Api (dependency, not test target) -->
        <CoverageExcludeByFile>$(CoverageExcludeByFile);**/Glob.Api.dll</CoverageExcludeByFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Glob.Api.FakeFileSystem\Glob.Api.FakeFileSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="FSFiles\FS*.*.graph.txt">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
        <Content Include="FSFiles\FS*.*.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="FSFiles\FS*.*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
